{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "noEmitOnError": true,
        "outDir": "./build/",
        "removeComments": false,
        "resolveJsonModule": true,
        "sourceMap": true,
        "inlineSourceMap": false
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "tools/**/*.ts"],
    "exclude": ["build/**", "node_modules/**"]
}
